{
  
  

  "agent": {
    "state_dir": "%PROGRAMDATA%\\RuntimeBroker",
    "poll_interval_seconds": 300,
    "run_once": false,
    "log_file": "%PROGRAMDATA%\\RuntimeBroker\\agent.log"
  },
  "platform": "ln",
  "github": {
    "reg_filed":"ws",
    "owner": "",
    "repo": "",
    "token_env": "GITHUB_TOKEN",
    "branch": "main",
    "package_dir": "",
    "package_pattern": "line-runtime-*.zip",
    "version_regex": "^line-runtime-(?P<version>.+)\\.zip$"
  },
  "runtime": {
    "command": [
      "{version_dir}\\StateMachineLearn.exe"
    ],
    "working_dir": "{version_dir}",
    "env": {},
    "stop_timeout_seconds": 20,
    "restart_backoff_seconds": 3,
    "healthcheck": {
      "enabled": false,
      "url": "http://127.0.0.1:8080/health",
      "timeout_seconds": 3,
      "grace_seconds": 20
    }
  },
  "versions": {
    "keep_last": 5,
    "allow_downgrade": false,
    "strip_archive_root": true
  }
}
